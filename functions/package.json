{
  "name": "functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=lib/index.js --external:firebase-admin --external:firebase-functions --external:sharp --external:heic-convert --external:@google-cloud/vision --external:@google-cloud/tasks --external:google-auth-library",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/storage": "^9.0.0",
    "@google-cloud/tasks": "^7.0.0",
    "@google-cloud/vision": "^6.2.0",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "google-auth-library": "^11.3.4",
    "heic-convert": "^2.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
